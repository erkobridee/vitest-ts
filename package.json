{
  "name": "vitest-ts",
  "type": "module",
  "version": "1.0.0",
  "description": "Vitest TypeScript project template",
  "scripts": {
    "start": "pnpm test",
    "test": "vitest watch",
    "test:index": "vitest run src/index.test.ts",
    "test-results": "vitest run --reporter=junit --output-file=reports/test-results.xml",
    "tsc": "npx tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erkobridee/vitest-ts.git"
  },
  "keywords": [
    "vitest",
    "typescript",
    "project",
    "template",
    "vitest-ts"
  ],
  "author": "Erko Bridee",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/erkobridee/vitest-ts/issues"
  },
  "homepage": "https://github.com/erkobridee/vitest-ts#readme",
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.11",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
